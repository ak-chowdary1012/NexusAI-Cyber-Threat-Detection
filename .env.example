# Author: Avinash Krishna — Team AVV Elites (SIH26153)
# .env.example
# SECURITY.md ref: §5 — copy this file to `.env` and fill in REAL values.
# `.env` itself is listed in .gitignore and must never be committed.
# Every value below is a placeholder; none of them work as-is.

# --- core ---
ENVIRONMENT=development          # development | production | test
DEBUG=false

# --- secrets: generate real random values, do not reuse these ---
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_A_REAL_RANDOM_48_BYTE_SECRET

# Local dev default is SQLite (no setup needed). Production MUST use
# Postgres — see docker-compose.yml, which builds this URL from
# POSTGRES_PASSWORD automatically; you do not need to set DATABASE_URL
# yourself when running via `docker compose up`.
DATABASE_URL=sqlite:///./dev.db
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_REAL_RANDOM_PASSWORD

# Rate-limit storage backend. Leave unset for local dev (falls back to
# in-memory, fine for one process). Required in production — see
# app/config.py::_validate_production_secrets.
REDIS_URL=

# --- CORS: exact origins your frontend is served from, comma-free JSON list ---
CORS_ALLOWED_ORIGINS=["http://localhost:8000"]

# --- email delivery (verification / password reset) ---
# Leave SMTP_HOST unset for local dev: emails print to the server console
# instead of sending (see app/services/email_service.py::ConsoleEmailBackend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@your-domain.example

# --- optional: LLM-narrated copilot summaries (platform enhancement only) ---
# Leave unset to run the copilot in retrieval-only mode (fully functional
# without this — see app/services/rag_service.py). If set, this key is used
# server-side ONLY and is never returned in any API response.
ANTHROPIC_API_KEY=
